# syntax=docker/dockerfile:1.12
ARG NODE_BASE=node:22.22.3-alpine3.23@sha256:968df39aedcea65eeb078fb336ed7191baf48f972b4479711397108be0966920
ARG NGINX_BASE=nginxinc/nginx-unprivileged:1.29.5-alpine3.23@sha256:42a7d7f2ee23e9f5a1dcdf3647ba5c585bbd18f79e79cd817e70e8cd61c55779

FROM ${NODE_BASE} AS web-build
WORKDIR /src/frontend
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
COPY frontend/.npmrc frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/apps/ ./apps/
COPY frontend/packages/ ./packages/
COPY frontend/tests/shell/ ./tests/shell/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts
RUN GO_ADMIN_BUILD_DIR=/out pnpm --filter @go-admin-plus/admin-web build

FROM ${NGINX_BASE} AS runtime
ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="go-admin-plus-web" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/go-admin-plus/go-admin-plus"
COPY --from=web-build /out/ /usr/share/nginx/html/
COPY release/linux/nginx/default.conf.template /etc/nginx/templates/default.conf.template
USER 101:101
EXPOSE 8080
