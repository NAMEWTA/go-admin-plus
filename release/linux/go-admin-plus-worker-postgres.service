[Unit]
Description=Go Admin Plus worker (PostgreSQL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=go-admin-plus
Group=go-admin-plus
WorkingDirectory=/var/lib/go-admin-plus
EnvironmentFile=-/etc/go-admin-plus/server.env
ExecStart=/opt/go-admin-plus/go-admin-plus-server worker --profile server-postgres --config /etc/go-admin-plus/server-postgres.yaml --data-root /var/lib/go-admin-plus
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/go-admin-plus

[Install]
WantedBy=multi-user.target
