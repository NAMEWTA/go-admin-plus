# syntax=docker/dockerfile:1.12
ARG GO_BASE=golang:1.26.8-alpine3.23@sha256:b5d1247cedefe8bf6b123f727dba9405edb9e9d8721d183f16f565b2f669e40c
ARG NODE_BASE=node:22.22.3-alpine3.23@sha256:968df39aedcea65eeb078fb336ed7191baf48f972b4479711397108be0966920

FROM ${GO_BASE} AS server-build
WORKDIR /src/go-admin-plus
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false \
      -ldflags="-s -w" -o /out/go-admin-plus ./cmd/server
RUN GOMODCACHE=/out/go-mod go mod download

FROM ${NODE_BASE} AS runtime
ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="go-admin-plus-server" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/go-admin-plus/go-admin-plus"
USER root
RUN apk add --no-cache ca-certificates git sqlite \
    && addgroup -S -g 10001 goadmin \
    && adduser -S -D -H -u 10001 -G goadmin goadmin \
    && mkdir -p /var/lib/go-admin-plus /opt/go-admin-plus \
    && chown -R 10001:10001 /var/lib/go-admin-plus
COPY --from=server-build --chown=10001:10001 /out/go-admin-plus /usr/local/bin/go-admin-plus
COPY --from=server-build /usr/local/go /usr/local/go
COPY --from=server-build --chown=10001:10001 /out/go-mod /opt/go-admin-plus/go-mod
ENV PATH=/usr/local/go/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    GOMODCACHE=/opt/go-admin-plus/go-mod \
    GOCACHE=/tmp/go-build \
    GOTOOLCHAIN=local \
    GOPROXY=off \
    GOSUMDB=off
USER 10001:10001
WORKDIR /var/lib/go-admin-plus
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/go-admin-plus"]
