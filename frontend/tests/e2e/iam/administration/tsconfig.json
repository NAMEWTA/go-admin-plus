{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@go-admin-plus/app-shell/*": ["../../../../packages/app-shell/src/*"],
      "@go-admin-plus/domain-iam/administration": ["../../../../packages/domains/iam/src/administration/index.ts"],
      "@go-admin-plus/domain-iam/session": ["../../../../packages/domains/iam/src/session/index.ts"],
      "@go-admin-plus/platform": ["../../../../packages/platform/src/index.ts"],
      "@go-admin-plus/web-domain-iam/administration": ["../../../../packages/web-domains/iam/src/administration/index.ts"],
      "@go-admin-plus/web-domain-iam/session": ["../../../../packages/web-domains/iam/src/session/index.ts"],
      "@go-admin-plus/ui": ["../../../../packages/ui/src/index.ts"],
      "vue": ["../../../../packages/web-domains/iam/node_modules/vue"]
    },
    "strict": true,
    "target": "ES2024",
    "types": ["vite/client"]
  },
  "include": ["./browser-driver.ts", "./vue.d.ts", "../../../../packages/**/*.vue"]
}
