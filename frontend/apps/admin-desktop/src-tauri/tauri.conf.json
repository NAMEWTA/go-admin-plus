{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Go Admin Plus",
  "version": "0.0.3",
  "identifier": "com.goadmin.plus",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "main-window"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Go Admin Plus",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/go-admin-sidecar"
    ],
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ]
  }
}
