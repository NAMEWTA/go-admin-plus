{
  "openapi": "3.1.0",
  "info": {
    "title": "Audit API",
    "version": "1.0.0",
    "description": "Authorized audit fact queries, detail, and retention cleanup.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/api",
      "description": "Same-origin API base path."
    }
  ],
  "security": [
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/audit/records": {
      "get": {
        "operationId": "listAuditRecords",
        "summary": "List authorized audit facts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AuditKind"
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AuditAction"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AuditOutcome"
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AuditSource"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A stable page of redacted audit facts.",
            "headers": {
              "X-CSRF-Token": {
                "$ref": "#/components/headers/CsrfToken"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationProblem"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationProblem"
          },
          "403": {
            "$ref": "#/components/responses/AuthorizedAuthorizationProblem"
          },
          "500": {
            "$ref": "#/components/responses/AuthorizedInternalProblem"
          }
        }
      }
    },
    "/audit/records/{id}": {
      "get": {
        "operationId": "getAuditRecord",
        "summary": "Read one authorized audit fact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 10,
              "maxLength": 350,
              "pattern": "^a1\\.(ls|lf|oc|ou|od)\\.[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The redacted audit fact.",
            "headers": {
              "X-CSRF-Token": {
                "$ref": "#/components/headers/CsrfToken"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditFact"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationProblem"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationProblem"
          },
          "403": {
            "$ref": "#/components/responses/AuthorizedAuthorizationProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/AuthorizedInternalProblem"
          }
        }
      }
    },
    "/audit/records/cleanup": {
      "post": {
        "operationId": "cleanupAuditRecords",
        "summary": "Delete one bounded batch of retention-eligible audit facts",
        "security": [
          {
            "SessionCookie": [],
            "CsrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CleanupAuditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The bounded cleanup result.",
            "headers": {
              "X-CSRF-Token": {
                "$ref": "#/components/headers/CsrfToken"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CleanupAuditResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationProblem"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationProblem"
          },
          "403": {
            "$ref": "#/components/responses/AuthorizedAuthorizationProblem"
          },
          "409": {
            "$ref": "#/components/responses/AuthorizedConflictProblem"
          },
          "500": {
            "$ref": "#/components/responses/AuthorizedInternalProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-go-admin-session",
        "description": "Opaque server-side session identifier. JavaScript cannot read the production cookie."
      },
      "CsrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Per-session anti-forgery token required for state-changing Web requests."
      }
    },
    "headers": {
      "CsrfToken": {
        "description": "The stable anti-forgery token shared by the authenticated Session family.",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43
        }
      }
    },
    "responses": {
      "ValidationProblem": {
        "description": "The request does not satisfy the declared contract.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "urn:go-admin-plus:problem:validation",
              "title": "Request validation failed",
              "status": 400,
              "category": "validation",
              "code": "REQUEST_INVALID",
              "traceId": "0123456789abcdef",
              "violations": [
                {
                  "field": "value",
                  "rule": "required",
                  "message": "Value is required."
                }
              ]
            }
          }
        }
      },
      "AuthenticationProblem": {
        "description": "A valid authenticated session is required.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "urn:go-admin-plus:problem:authentication",
              "title": "Authentication required",
              "status": 401,
              "category": "authentication",
              "code": "SESSION_REQUIRED",
              "traceId": "0123456789abcdef"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "urn:go-admin-plus:problem:not-found",
              "title": "Resource not found",
              "status": 404,
              "category": "not_found",
              "code": "RESOURCE_NOT_FOUND",
              "traceId": "0123456789abcdef"
            }
          }
        }
      },
      "AuthorizedAuthorizationProblem": {
        "description": "The authenticated account cannot perform this operation.",
        "headers": {
          "X-CSRF-Token": {
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            }
          },
          "Set-Cookie": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "AuthorizedConflictProblem": {
        "description": "The cleanup conflicts with the retention policy.",
        "headers": {
          "X-CSRF-Token": {
            "$ref": "#/components/headers/CsrfToken"
          },
          "Set-Cookie": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "AuthorizedInternalProblem": {
        "description": "The request failed without exposing infrastructure details.",
        "headers": {
          "X-CSRF-Token": {
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            }
          },
          "Set-Cookie": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "category",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "Stable problem type identifier."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "category": {
            "type": "string",
            "enum": [
              "validation",
              "authentication",
              "authorization",
              "not_found",
              "conflict",
              "internal"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "detail": {
            "type": "string",
            "maxLength": 512,
            "description": "Safe client-facing context without infrastructure details."
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "traceId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64,
            "pattern": "^[a-f0-9]+$"
          },
          "violations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ValidationViolation"
            }
          }
        }
      },
      "AuditKind": {
        "type": "string",
        "enum": [
          "login",
          "operation"
        ]
      },
      "AuditAction": {
        "type": "string",
        "enum": [
          "login",
          "create",
          "update",
          "delete"
        ]
      },
      "AuditOutcome": {
        "type": "string",
        "enum": [
          "succeeded",
          "failed"
        ]
      },
      "AuditSource": {
        "type": "string",
        "enum": [
          "web",
          "desktop",
          "server"
        ]
      },
      "ActorType": {
        "type": "string",
        "enum": [
          "account",
          "system"
        ]
      },
      "AuditFact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "action",
          "outcome",
          "actorType",
          "source",
          "subject",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 10,
            "maxLength": 350,
            "pattern": "^a1\\.(ls|lf|oc|ou|od)\\.[A-Za-z0-9_-]+$"
          },
          "eventId": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "traceId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "$ref": "#/components/schemas/AuditKind"
          },
          "action": {
            "$ref": "#/components/schemas/AuditAction"
          },
          "outcome": {
            "$ref": "#/components/schemas/AuditOutcome"
          },
          "actorType": {
            "$ref": "#/components/schemas/ActorType"
          },
          "source": {
            "$ref": "#/components/schemas/AuditSource"
          },
          "subject": {
            "type": "string",
            "minLength": 3,
            "maxLength": 132,
            "pattern": "^[a-z0-9][a-z0-9_:-]+$"
          },
          "actorRef": {
            "type": "string",
            "minLength": 9,
            "maxLength": 72,
            "pattern": "^account:[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuditPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "records",
          "total",
          "page",
          "pageSize"
        ],
        "properties": {
          "records": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/AuditFact"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "CleanupAuditRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "confirmation"
        ],
        "properties": {
          "before": {
            "type": "string",
            "format": "date-time"
          },
          "confirmation": {
            "type": "string",
            "const": "delete-expired-audit-records"
          }
        }
      },
      "CleanupAuditResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deleted",
          "moreEligible"
        ],
        "properties": {
          "deleted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "moreEligible": {
            "type": "boolean"
          }
        }
      },
      "ValidationViolation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "rule"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    }
  },
  "x-go-admin-module": "audit",
  "x-go-admin-codegen": {
    "owner": "audit",
    "goPackage": "audittransport",
    "goOutput": "backend/internal/modules/audit/transport/openapi.gen.go",
    "typescriptOutput": "frontend/packages/domains/audit/src/generated"
  }
}